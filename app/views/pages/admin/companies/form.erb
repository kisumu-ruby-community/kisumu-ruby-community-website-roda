<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 pt-6">
  <%= render("partials/admin_nav") %>
</div>

<!-- Page header -->
<section class="relative overflow-hidden bg-bg border-b border-border">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center gap-4">
      <a href="/admin/companies" class="inline-flex items-center gap-1.5 text-sm text-foreground-muted hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
        Back
      </a>
      <h1 class="text-2xl font-bold text-foreground font-mono"><%= company ? "Edit Company" : "New Company" %></h1>
    </div>
  </div>
</section>

<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-10">

  <% unless errors.empty? %>
    <div class="rounded-xl border border-error-border bg-error-bg px-5 py-4 text-sm text-error-foreground mb-8">
      <ul class="list-disc list-inside space-y-1">
        <% errors.each do |_, msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <form action="<%= company ? "/admin/companies/#{company.id}" : "/admin/companies" %>" method="post">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">

      <!-- Left: main fields -->
      <div class="lg:col-span-2 space-y-5">

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Name <span class="text-primary">*</span></label>
          <input type="text" name="name" value="<%= company&.name %>" required
            placeholder="e.g. Andela"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Website URL <span class="text-primary">*</span></label>
          <input type="url" name="website_url" value="<%= company&.website_url %>" required
            placeholder="https://example.com"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted font-mono focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Logo URL</label>
          <input type="url" name="logo_url" value="<%= company&.logo_url %>"
            placeholder="https://example.com/logo.png"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted font-mono focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Description</label>
          <textarea name="description" rows="4" maxlength="280"
            placeholder="A short description of what the company builds…"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary resize-none"><%= company&.description %></textarea>
        </div>

      </div>

      <!-- Right: settings sidebar -->
      <div class="space-y-5">

        <div class="rounded-xl border border-border bg-bg-subtle p-5 space-y-5">
          <h2 class="text-sm font-semibold text-foreground font-mono">Settings</h2>

          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">Country</label>
            <input type="text" name="country" value="<%= company&.country %>"
              placeholder="e.g. Kenya, Nigeria, Ghana"
              class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary" />
            <p class="mt-1.5 text-xs text-foreground-subtle">Used to filter companies on the public page.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">Category</label>
            <input type="text" name="category" value="<%= company&.category %>"
              placeholder="e.g. Fintech, E-commerce, HealthTech"
              class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>

          <label class="flex items-center gap-2 cursor-pointer">
            <input type="hidden" name="is_approved" value="0" />
            <input type="checkbox" name="is_approved" value="1" <%= "checked" if company.nil? || company.is_approved %>
              class="h-4 w-4 rounded border-border text-primary focus:ring-primary" />
            <span class="text-sm font-medium text-foreground">Published</span>
          </label>
          <p class="text-xs text-foreground-subtle -mt-3">Only published companies appear on the public "Built with Ruby" page.</p>
        </div>

        <div class="flex flex-col gap-3">
          <button type="submit" data-loading="Saving..." class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-hover transition-colors cursor-pointer">
            <%= company ? "Save Changes" : "Create Company" %>
          </button>
          <a href="/admin/companies" class="w-full inline-flex items-center justify-center rounded-xl border border-border px-5 py-2.5 text-sm font-medium text-foreground hover:bg-bg-subtle transition-colors">Cancel</a>
        </div>

      </div>
    </div>
  </form>
</div>
