<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 pt-6">
  <%= render("partials/admin_nav") %>
</div>

<!-- Page header -->
<section class="relative overflow-hidden bg-bg border-b border-border">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:48px_48px] opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center gap-4">
      <a href="/admin/resources" class="inline-flex items-center gap-1.5 text-sm text-foreground-muted hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
        Back
      </a>
      <h1 class="text-2xl font-bold text-foreground font-mono"><%= resource ? "Edit Resource" : "New Resource" %></h1>
    </div>
  </div>
</section>

<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-10">

  <% unless errors.empty? %>
    <div class="rounded-xl border border-error-border bg-error-bg px-5 py-4 text-sm text-error-foreground mb-8">
      <ul class="list-disc list-inside space-y-1">
        <% errors.each do |_, msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <form action="<%= resource ? "/admin/resources/#{resource.id}" : "/admin/resources" %>" method="post">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-16">

      <!-- Left: main fields -->
      <div class="lg:col-span-2 space-y-5">

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Title <span class="text-primary">*</span></label>
          <input type="text" name="title" value="<%= resource&.title %>" required
            placeholder="e.g. The Well-Grounded Rubyist"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">URL <span class="text-primary">*</span></label>
          <input type="url" name="url" value="<%= resource&.url %>" required
            placeholder="https://example.com"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted font-mono focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-foreground mb-1.5">Description</label>
          <textarea name="description" rows="4" maxlength="280"
            placeholder="A short description of what this resource covers…"
            class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary resize-none"><%= resource&.description %></textarea>
        </div>

      </div>

      <!-- Right: settings sidebar -->
      <div class="space-y-5">

        <div class="rounded-xl border border-border bg-bg-subtle p-5 space-y-5">
          <h2 class="text-sm font-semibold text-foreground font-mono">Settings</h2>

          <div>
            <label class="block text-sm font-medium text-foreground mb-1.5">Category</label>
            <input type="text" name="category" value="<%= resource&.category %>"
              placeholder="e.g. Getting Started, Books, Tools"
              class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-foreground placeholder:text-foreground-muted focus:outline-none focus:ring-2 focus:ring-primary" />
            <p class="mt-1.5 text-xs text-foreground-subtle">Used to group and filter resources on the public page.</p>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <button type="submit" data-loading="Saving..." class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-hover transition-colors cursor-pointer">
            <%= resource ? "Save Changes" : "Create Resource" %>
          </button>
          <a href="/admin/resources" class="w-full inline-flex items-center justify-center rounded-xl border border-border px-5 py-2.5 text-sm font-medium text-foreground hover:bg-bg-subtle transition-colors">Cancel</a>
        </div>

      </div>
    </div>
  </form>
</div>
