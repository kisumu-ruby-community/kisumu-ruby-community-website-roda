<div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8 py-10">
  <%= render("partials/admin_nav") %>
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-foreground font-mono">Resources</h1>
    <a href="/admin/resources/new" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary-hover active:bg-primary-active transition-colors duration-150">
      + New Resource
    </a>
  </div>

  <% if resources.empty? %>
    <p class="text-foreground-muted text-sm">No resources yet. <a href="/admin/resources/new" class="text-primary hover:underline">Add the first one.</a></p>
  <% else %>

    <!-- Mobile cards -->
    <div class="space-y-3 lg:hidden">
      <% resources.each do |res| %>
        <div class="rounded-xl border border-border bg-bg p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium text-foreground truncate"><%= res.title %></p>
              <p class="text-xs text-foreground-muted mt-0.5 font-mono truncate"><%= res.display_host %></p>
            </div>
            <% if res.category %>
              <span class="shrink-0 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-primary-muted text-primary"><%= res.category %></span>
            <% end %>
          </div>
          <p class="text-xs text-foreground-subtle"><%= res.created_at&.strftime("%d %b %Y") %></p>
          <div class="flex items-center gap-4 pt-1 border-t border-border">
            <a href="/admin/resources/<%= res.id %>/edit" class="text-sm text-primary hover:underline">Edit</a>
            <form action="/admin/resources/<%= res.id %>/delete" method="post" class="delete-form">
              <button type="button" class="delete-btn text-sm text-red-600 hover:underline cursor-pointer" data-title="<%= res.title %>">Delete</button>
            </form>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Desktop table -->
    <div class="hidden lg:block rounded-xl border border-border overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-bg-subtle border-b border-border">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-foreground">Title</th>
            <th class="px-4 py-3 text-left font-semibold text-foreground">Category</th>
            <th class="px-4 py-3 text-left font-semibold text-foreground">Domain</th>
            <th class="px-4 py-3 text-left font-semibold text-foreground">Added</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% resources.each do |res| %>
            <tr class="bg-bg hover:bg-bg-subtle transition-colors">
              <td class="px-4 py-3 font-medium text-foreground"><%= res.title %></td>
              <td class="px-4 py-3 text-foreground-muted">
                <% if res.category %>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-primary-muted text-primary"><%= res.category %></span>
                <% else %>
                  <span class="text-foreground-subtle">-</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-foreground-muted font-mono text-xs"><%= res.display_host %></td>
              <td class="px-4 py-3 text-foreground-muted"><%= res.created_at&.strftime("%d %b %Y") %></td>
              <td class="px-4 py-3 text-right space-x-3">
                <a href="/admin/resources/<%= res.id %>/edit" class="text-sm text-primary hover:underline">Edit</a>
                <form action="/admin/resources/<%= res.id %>/delete" method="post" class="inline delete-form">
                  <button type="button" class="delete-btn text-sm text-red-600 hover:underline cursor-pointer" data-title="<%= res.title %>">Delete</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>
</div>
