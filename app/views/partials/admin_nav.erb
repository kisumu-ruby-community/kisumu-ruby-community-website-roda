<nav class="border-b border-border mb-8">
  <div class="flex items-center gap-1 h-12">
    <% [["Events", "/admin/events"], ["Resources", "/admin/resources"], ["Companies", "/admin/companies"]].each do |label, path| %>
      <% active = request.path.start_with?(path) %>
      <a href="<%= path %>" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors duration-150 <%= active ? 'bg-primary-subtle text-primary' : 'text-foreground-muted hover:text-foreground hover:bg-bg-muted' %>">
        <%= label %>
      </a>
    <% end %>
  </div>
</nav>
